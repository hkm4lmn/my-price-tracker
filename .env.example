# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://tracker:tracker@localhost:5432/tracker
# From @BotFather
TELEGRAM_BOT_TOKEN=
# Any long random string; Telegram sends it back on every webhook call
TELEGRAM_WEBHOOK_SECRET=
# Public HTTPS address of the web app, used in links and the webhook
PUBLIC_BASE_URL=http://localhost:8000
# Bot username without @, shown on the home page
BOT_USERNAME=
